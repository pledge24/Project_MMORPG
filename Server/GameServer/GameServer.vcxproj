       (기존 PreBuildEvent + UpToDateCheckInput 조합은 Visual Studio IDE에서만 통했다)
       스키마 목록은 타깃이 돌 때 모은다. 평가 시점의 항목으로 두면 IDE의 파일 목록에 한 번 더 보인다.
       Outputs에 스키마마다의 .pb.h를 두므로, 스키마 파일을 더하면 그 생성물이 없어서 타깃이 돈다.
       스크립트는 실패하면 1로 끝나고, Exec가 그 종료 코드로 빌드를 멈춘다. -->
  <Target Name="CollectProtoSchemas">
    <ItemGroup>
      <ProtoSchema Include="$(MSBuildProjectDirectory)\..\..\Protocol\Schema\*.proto" />
    </ItemGroup>
  </Target>
  <Target Name="GenerateProtoPackets"
          BeforeTargets="ClCompile"
          DependsOnTargets="CollectProtoSchemas"
          Inputs="@(ProtoSchema)"
          Outputs="@(ProtoSchema->'$(MSBuildProjectDirectory)\Protocol\%(Filename).pb.h');$(MSBuildProjectDirectory)\Network\ServerPacketHandler.h">
    <Message Importance="high" Text="[Proto] 스키마가 생성물보다 새로워 Generate.ps1을 돌린다" />
    <Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Protocol\Generate.ps1&quot;" />
  </Target>
</Project>