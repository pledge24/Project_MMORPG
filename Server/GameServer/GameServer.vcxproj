  <!-- .proto가 바뀌었을 때만 GenPackets.bat을 돌린다.
       MSBuild 타겟 그래프의 일부라 VS·Rider·CLI 어디서든 동일하게 동작한다.
       (기존 PreBuildEvent + UpToDateCheckInput 조합은 Visual Studio IDE에서만 통했다)
       < NUL: GenPackets.bat이 PAUSE로 끝나므로 stdin에 EOF를 먹여 멈추지 않게 한다.
       .bat은 pushd %~dp0로 시작해 CWD 독립적이므로 WorkingDirectory가 불필요하다. -->
  <Target Name="GenerateProtoPackets"
          BeforeTargets="ClCompile"
          Inputs="$(SolutionDir)Common\Protobuf\bin\Enum.proto;$(SolutionDir)Common\Protobuf\bin\Struct.proto;$(SolutionDir)Common\Protobuf\bin\Protocol.proto"
          Outputs="$(MSBuildProjectDirectory)\Protocol\Enum.pb.h;$(MSBuildProjectDirectory)\Protocol\Struct.pb.h;$(MSBuildProjectDirectory)\Protocol\Protocol.pb.h;$(MSBuildProjectDirectory)\Main\ServerPacketHandler.h">
    <Message Importance="high" Text="[Proto] .proto changed - running GenPackets.bat" />
    <Exec Command="set &quot;PATH=$(SolutionDir)Common\Protobuf\bin;%PATH%&quot; &amp;&amp; CALL &quot;$(SolutionDir)Common\Protobuf\bin\GenPackets.bat&quot; &lt; NUL"
          WorkingDirectory="$(SolutionDir)Common\Protobuf\bin" />
  </Target>
