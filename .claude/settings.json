{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_dangerous_cmd.py"
            ],
            "timeout": 10,
            "statusMessage": "위험 명령 검사 중"
          }
        ]
      },
      {
        "matcher": "mcp__rider__execute_terminal_command|mcp__rider__execute_sql_query",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_dangerous_cmd.py"
            ],
            "timeout": 10,
            "statusMessage": "위험 명령 검사 중"
          }
        ]
      }
    ]
  }
}
