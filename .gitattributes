# 기본값: UTF-8 텍스트 파일
* text=auto encoding=UTF-8

# XML 파일들 (UTF-8)
*.xml text encoding=UTF-8

# 기타 텍스트 파일들도 UTF-8로
*.txt text encoding=UTF-8
*.md text encoding=UTF-8
*.json text encoding=UTF-8

# 바이너리 파일들
*.exe binary
*.dll binary
*.jpg binary
*.png binary
# 서버가 읽는 navmesh. 빌드 도구(Tools/NavBuilder)가 쓰는 Detour 타일 데이터다.
*.navmesh binary

# git 훅은 줄바꿈을 LF로 고정한다.
# core.autocrlf 가 true 인 환경에서 CRLF 로 체크아웃되면 `#!/bin/sh` 뒤에 \r 이 붙어
# Git Bash 가 인터프리터를 찾지 못한다. LFS 의 pre-push 가 그렇게 죽으면 포인터만 push 되고
# 에셋 본체가 올라가지 않는데, 그 실패는 다른 사람이 클론할 때까지 드러나지 않는다.
.githooks/* text eol=lf

# 생성기가 LF로 쓰는 산출물은 체크아웃도 LF로 고정한다.
# core.autocrlf 가 true 인 환경에서 CRLF 로 체크아웃되면, 원본을 고치지 않고 생성기만 다시 돌려도
# 산출물 전체가 바뀐 파일로 보여서 무엇이 실제로 바뀌었는지 git status 로 가릴 수 없다.
Server/GameServer/Protocol/*.pb.* text eol=lf
Server/DummyClient/Protocol/*.pb.* text eol=lf
P1/Source/P1/Network/*.pb.* text eol=lf
Server/GameServer/Game/Data/Generated/** text eol=lf
Server/GameServer/Lobby/Data/Generated/** text eol=lf
P1/DesignData/Generated/** text eol=lf
P1/Source/P1/Game/Data/Generated/** text eol=lf
Server/GameServer/Game/Data/Extracted/*.json text eol=lf

# 언리얼 에셋은 Git LFS로 추적한다 (ADR-0006).
# 추적 범위는 P1/.gitignore의 화이트리스트가 정한다. 여기서는 형식만 정한다.
# -text 를 붙이는 이유는 위의 `* text=auto` 가 이 바이너리에 줄바꿈 변환을 걸지 못하게 막는 것이다.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
